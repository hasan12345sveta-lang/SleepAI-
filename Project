          animation: {
            'pulse-slow': 'pulse 6s cubic-bezier(0.4, 0, 0.6, 1) infinite',
            'float': 'float 6s ease-in-out infinite',
          },
          keyframes: {
            float: {
              '0%, 100%': { transform: 'translateY(0px)' },
              '50%': { transform: 'translateY(-8px)' },
            }
          }
        }
      }
    }
  </script>

  <style>
    /* Smooth hardware-accelerated transitions */
    * {
      box-sizing: border-box;
    }
    html {
      scroll-behavior: smooth;
    }
    body {
      font-family: 'Inter', sans-serif;
      overflow-x: hidden;
      transition: background-color 0.35s ease, color 0.35s ease;
    }

    /* Glassmorphism panels */
    .glass-panel {
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.25s ease, background-color 0.35s ease, border-color 0.35s ease;
    }
    .dark .glass-panel {
      background: rgba(15, 22, 46, 0.68);
      border: 1px solid rgba(129, 140, 248, 0.16);
      box-shadow: 0 12px 40px -10px rgba(0, 0, 0, 0.55);
    }
    html:not(.dark) .glass-panel {
      background: rgba(255, 255, 255, 0.82);
      border: 1px solid rgba(99, 102, 241, 0.14);
      box-shadow: 0 12px 32px -8px rgba(30, 41, 59, 0.08);
    }

    .glass-card-hover:hover {
      transform: translateY(-3px);
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(99, 102, 241, 0.35);
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: rgba(99, 102, 241, 0.6);
    }

    /* Custom Range Sliders */
    input[type="range"] {
      -webkit-appearance: none;
      appearance: none;
      height: 6px;
      border-radius: 999px;
      outline: none;
    }
    .dark input[type="range"] {
      background: rgba(255, 255, 255, 0.12);
    }
    html:not(.dark) input[type="range"] {
      background: rgba(15, 23, 42, 0.12);
    }
    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: #6366F1;
      cursor: pointer;
      box-shadow: 0 0 10px rgba(99, 102, 241, 0.6);
      transition: transform 0.15s ease;
    }
    input[type="range"]::-webkit-slider-thumb:hover {
      transform: scale(1.15);
    }

    /* Animated Ambient Background Orbs */
    .ambient-orb {
      position: fixed;
      border-radius: 9999px;
      filter: blur(95px);
      pointer-events: none;
      z-index: 0;
      will-change: transform;
    }

    /* Shake animation for wrong alarm challenge answer */
    @keyframes shakeError {
      0%, 100% { transform: translateX(0); }
      20%, 60% { transform: translateX(-8px); }
      40%, 80% { transform: translateX(8px); }
    }
    .animate-shake {
      animation: shakeError 0.35s ease-in-out;
    }

    /* Markdown formatting inside Sleep AI */
    .ai-prose h4 { font-weight: 700; margin-top: 0.65rem; margin-bottom: 0.25rem; color: #818cf8; }
    html:not(.dark) .ai-prose h4 { color: #4f46e5; }
    .ai-prose ul { list-style-type: disc; padding-left: 1.25rem; margin: 0.35rem 0; }
    .ai-prose li { margin-bottom: 0.2rem; }
    .ai-prose strong { font-weight: 600; }
  </style>
</head>
